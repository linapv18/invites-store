# Public browser configuration. No service_role or secret key belongs here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Server only (Vercel): custom-quote form (/api/cotizacion) sends requests by email with Resend.
# The sender must use a domain verified in Resend (mail.invitesse.com). QUOTE_TO defaults to hola@invitesse.com.
# RESEND_API_KEY=re_your-server-key
# QUOTE_FROM=Invitesse <cotizaciones@mail.invitesse.com>
# QUOTE_TO=hola@invitesse.com

# Server only, configure in Vercel for authorized private-file signing. Never expose it.
# SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Server only (Vercel): admin panel at /admin/. Comma-separated emails of the Supabase accounts allowed in.
# ADMIN_EMAILS=hola@invitesse.com

# Server only: Vercel API token with access to this team/project for /admin/ traffic reports.
# Store as a Production Secret in Vercel; never paste in chat or expose in browser config.
# VERCEL_ANALYTICS_TOKEN=
# VERCEL_PROJECT_ID is provided by Vercel; project name invites-store is the fallback.
# VERCEL_ANALYTICS_TEAM_ID=team_lCM12u8gqwtrRnVvQ10bpmRR
